# Installed inside nginx http {} on the HOST. Render with render-pilot.mjs.
# Requires already-issued TLS certificate; bootstrap ACME is a separate step.
limit_conn_zone $binary_remote_addr zone=citygo_per_ip:10m;
log_format citygo_minimal '$status $request_time';

server {
    listen 80 default_server;
    server_name _;
    access_log off;
    error_log /var/log/nginx/citygo-error.log crit;
    return 444;
}
server {
    listen 80;
    server_name __CITYGO_HOST__;
    access_log off;
    error_log /var/log/nginx/citygo-error.log crit;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://__CITYGO_HOST__$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    access_log off;
    error_log /var/log/nginx/citygo-error.log crit;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 443 ssl;
    server_name __CITYGO_HOST__;
    ssl_certificate /etc/letsencrypt/live/__CITYGO_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CITYGO_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:citygo_tls:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    access_log /var/log/nginx/citygo-access.log citygo_minimal;
    error_log /var/log/nginx/citygo-error.log crit;
    client_max_body_size 32k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 300s;
    limit_conn citygo_per_ip 40;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    location / {
        # Fail closed until an operator explicitly admits traffic on the HOST.
        # No reload: each NEW request checks the marker, including keep-alive.
        open_file_cache off;
        error_page 503 = @citygo_maintenance;
        if (!-f /var/lib/citygo/ingress/traffic-open) { return 503; }
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host __CITYGO_HOST__;
        proxy_set_header X-Forwarded-Host __CITYGO_HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_cache off;
        # Preserve the application's own 503 body/contract when ingress is open.
        proxy_intercept_errors off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_next_upstream off;
    }
    location @citygo_maintenance {
        default_type application/json;
        charset utf-8;
        charset_types application/json;
        add_header Cache-Control no-store always;
        add_header X-CityGo-Contract-Version 1 always;
        add_header X-Request-Id $request_id always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        return 503 '{"error":"CityGo обновляется. Дождитесь завершения и проверьте историю перед повторной отправкой.","code":"SERVICE_UNAVAILABLE","contractVersion":"1","requestId":"$request_id","retryable":false}';
    }
}
