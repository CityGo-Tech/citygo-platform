# NON-SECRET deployment metadata only. Never put DB passwords or AI keys here.
# Registry publication/digests will be supplied by the separately approved release.
CITYGO_API_IMAGE=ghcr.io/citygo-tech/citygo-platform-api@sha256:REPLACE_WITH_APPROVED_DIGEST
CITYGO_WEB_IMAGE=ghcr.io/citygo-tech/citygo-platform-web@sha256:REPLACE_WITH_APPROVED_DIGEST
CITYGO_JOBS_IMAGE=ghcr.io/citygo-tech/citygo-platform-jobs@sha256:REPLACE_WITH_APPROVED_DIGEST
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_APPROVED_DIGEST
CITYGO_ORIGIN=https://pilot.example.test
CITYGO_SECRETS_DIR=/etc/citygo/secrets
CITYGO_DB_VOLUME=citygo_pilot_data
