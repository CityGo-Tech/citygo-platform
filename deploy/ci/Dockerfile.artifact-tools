# No host Docker socket, keys or user profile should be mounted here.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

# Debian's signed package repositories remain enabled; do not use trusted=yes
