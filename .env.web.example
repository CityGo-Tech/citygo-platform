# Copy to root .env.web, NOT apps/web/.env*. No DB or AI credentials here.
# Next rewrites bake this route into the build; rebuild after changing it.
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Public build inputs only, no API key. Keep OFF until the site domain,
# privacy masking and collection notice are reviewed for this release.
NEXT_PUBLIC_CITYGO_METRIKA_ENABLED=disabled
NEXT_PUBLIC_CITYGO_METRIKA_COUNTER_ID=
NEXT_PUBLIC_CITYGO_METRIKA_WEBVISOR=disabled
