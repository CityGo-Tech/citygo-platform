{
  "name": "citygo-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "browser:install": "playwright install chromium",
    "build": "turbo run build --concurrency=3",
    "dev": "node scripts/run.mjs dev",
    "lint": "turbo run lint --concurrency=3 && eslint scripts e2e playwright.config.ts",
    "test": "turbo run test --concurrency=3",
    "typecheck": "turbo run typecheck --concurrency=3",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:startup",
    "test:startup": "node --test scripts/startup.test.mjs",
    "clean": "turbo run clean",
    "db:migrate": "node scripts/run.mjs migrate",
    "start": "node scripts/run.mjs start",
    "test:e2e": "playwright test",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:sync": "node scripts/sync-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:dev": "pnpm --filter @citygo/mobile dev",
    "mobile:export": "pnpm --filter @citygo/mobile export",
    "worker:once": "node scripts/worker.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "prettier": "^3.6.2"
  }
}
