{
  "name": "@citygo/db",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=3 \"src/**/*.test.ts\"",
    "build": "tsup src/index.ts src/cli.ts src/release-cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "@electric-sql/pglite": "^0.5.13",
    "@citygo/contracts": "workspace:*",
    "@citygo/domain": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "@types/pg": "^8.15.5"
  }
}
