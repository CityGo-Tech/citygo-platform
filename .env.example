# pnpm dev reads this file from the repository root after copying it to .env.
# Default: embedded PostgreSQL for local development; data survives restarts.
DATABASE_URL=pglite://.local/database
# For Docker/server: postgresql://citygo:citygo@localhost:5432/citygo
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty means no trusted proxies (safe local default). Production requires an
# explicit IP/CIDR allowlist and a sanitizing HTTPS ingress; see production.md.
TRUSTED_PROXY_CIDRS=
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Empty preserves legacy OpenAI selection when both OPENAI_* values are set.
# 'disabled' explicitly turns AI off. 'openai' requires both values.
# routerai/gigachat are reserved; their adapters ship in subsequent PRs.
LLM_PROVIDER=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=1400
OPENAI_API_KEY=
OPENAI_MODEL=
# Comma-separated internal user IDs, not email addresses.
ADMIN_USER_IDS=
