# API settings: copy to root .env.api (recommended) or legacy root .env.
# The launcher filters settings separately for each service; never copies the
# entire file to Web/build/tests. See docs/runbooks/service-environments.md.
# Separate optional templates: .env.web.example, .env.mobile.example,
# .env.worker.example and .env.migrator.example. Injected variables win over files.
# Default: embedded PostgreSQL for local development; data survives restarts.
DATABASE_URL=pglite://.local/database
# For Docker/server: postgresql://citygo:citygo@localhost:5432/citygo
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty means no trusted proxies (safe local default). Production requires an
# explicit IP/CIDR allowlist and a sanitizing HTTPS ingress; see production.md.
TRUSTED_PROXY_CIDRS=
# Email confirmation is staged, not a configured mailing service. Keep disabled
# until a real provider, protected secret and dedicated runtime are reviewed.
# required without a delivery adapter closes NEW registration, never login.
EMAIL_REGISTRATION_MODE=disabled
# Generate a separate random32-byte secret (64 lower-case hex); never reuse an
# AI, payment, backup or session credential. No delivery secret goes to Web/build.
EMAIL_REGISTRATION_SECRET=
# Prepared providers, OFF until account/DNS/sender/cost/data approval and release.
EMAIL_DELIVERY_PROVIDER=disabled
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
POSTBOX_FROM_EMAIL=
# Postbox requires positive admission caps or the explicit literal unlimited.
# 0 stays fail-closed; unlimited removes only global daily/lifetime email caps.
# Recipient/IP anti-abuse limits remain. These settings are not price approval.
EMAIL_SEND_DAILY_LIMIT=0
EMAIL_SEND_TOTAL_LIMIT=0
PHONE_VERIFICATION_MODE=disabled
# Separate stable identity HMAC; changing it requires a reviewed DB transition.
PHONE_VERIFICATION_SECRET=
SMS_RU_MODE=disabled
SMS_RU_API_ID=
SMS_RU_FROM=
# Selected next provider: OFF until tariff/API/sender approval and release.
# API-key auth only. Do not put account passwords into this config.
PROSTOSMS_MODE=disabled
PROSTOSMS_API_KEY=
PROSTOSMS_SENDER=
PHONE_SMS_GLOBAL_DAILY_LIMIT=0
PHONE_SMS_GLOBAL_TOTAL_LIMIT=0
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Bootstrap choice for a new database; then /admin controls the saved selection.
# Bootstrap is validated at each startup. Keep its required settings complete.
# Empty initially selects OpenAI when both OPENAI_* values are set.
# 'disabled' is a server-level hard stop even if the DB selects a provider.
# The admin cannot enable AI on a server with this hard stop.
# routerai: production blocked unless exact public notice/policy is approved.
# gigachat: same local-only boundary; production activation is blocked.
LLM_PROVIDER=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=1400
# Instructions + message JSON in UTF-8 bytes; not tokens or provider wire overhead.
LLM_MAX_INPUT_BYTES=64000
# Migration 0006 starts the monetary budget DISABLED, including for OpenAI.
# Configure currency, daily/total allowances and verified per-attempt ceilings in /admin.
# No live prices or positive budgets are provided. See docs/runbooks/ai-providers.md.
# UTC daily accepted-chat caps across providers/processes. 0 blocks new chats.
# These are NOT monetary budgets; retries and provider billing may differ.
LLM_USER_DAILY_REQUEST_LIMIT=20
LLM_GLOBAL_DAILY_REQUEST_LIMIT=200
# Model-attempt reservations, separately from accepted chat messages. Includes retries.
# No refunds on errors/cancellation. Not billed calls, currency or a spending guarantee.
# First reservation pins both caps for the UTC day across replicas; keep them identical.
# Change positive values for the next UTC day; 0 is an immediate new-attempt stop.
LLM_USER_DAILY_ATTEMPT_LIMIT=20
LLM_GLOBAL_DAILY_ATTEMPT_LIMIT=200
OPENAI_API_KEY=
OPENAI_MODEL=
# Configured adapters are prepared for manual admin selection, without live calls.
# Keep OpenAI settings for an explicit return to direct OpenAI.
# No model/provider is chosen automatically. See docs/runbooks/ai-providers.md.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=
ROUTERAI_UPSTREAM=
# Optional lowercase two-letter geographic filter; no default country.
ROUTERAI_COUNTRY=
# Public notice and operator-approved policy ID; blank keeps production blocked.
# Neither is a credential. Never paste keys into the notice (users will see it).
# See docs/runbooks/routerai-production.md. Does not enable budgets or consent.
ROUTERAI_DATA_NOTICE=
ROUTERAI_PRODUCTION_POLICY_ID=
# Optional RouterAI-only overrides; empty preserves the shared LLM_* defaults.
# Current CityGo profile: deepseek/deepseek-v4-pro-0813, upstream deepseek,
# country us, high / 32768 / 240000; see docs/runbooks/routerai-deepseek.md.
# Keep direct OpenAI and GigaChat configured independently.
ROUTERAI_REASONING_EFFORT=
ROUTERAI_MAX_OUTPUT_TOKENS=
ROUTERAI_REQUEST_TIMEOUT_MS=
# Optional user-selectable modes. OFF until exact bundle, budgets and runtime
# are reviewed. Uses the same RouterAI API key; never exposes it to clients.
# Maximum and Balance pin separate RouterAI profiles. Minimum needs a verified
# direct GigaChat billing basis before paid production can be enabled.
AI_ASSISTANT_MODES=disabled
# Explicit Minimum flat fee: 3 RUB CityGo only for a successful Ultra/PERS reply.
# Keep disabled until its runtime, account and billing profile are reviewed.
AI_MINIMUM_FIXED_FEE=disabled
AI_MODES_PRODUCTION_POLICY_ID=
AI_MODES_DATA_NOTICE=
AI_MAXIMUM_REASONING_EFFORT=medium
# Native RouterAI search candidate: disabled by default; non-production only.
# routerai_native_candidate_v1 requires disabled customer credits, legacy
# billing, full reservation mode, operator_ceiling and no Minimum fixed fee.
# No live test, complete search-cost receipt or production approval is implied.
AI_MAXIMUM_WEB_SEARCH=disabled
# GigaChat API key, no Basic prefix. Not a giga.chat website password.
# Supabase's SHA-256 secret digest and Client ID are NOT authorization keys.
# Choose the account-specific scope explicitly; there is no default model/scope.
# Personal-only Ultra profile: GIGACHAT_MODEL=GigaChat-3-Ultra,
# GIGACHAT_SCOPE=GIGACHAT_API_PERS. No automatic selection or live activation.
# See docs/runbooks/gigachat-ultra.md for Freemium restrictions and key setup.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=
GIGACHAT_SCOPE=
# Optional path to a verified PEM CA bundle. Applies only to GigaChat connections.
# Never disable TLS verification. Missing/invalid configured CA files fail startup.
GIGACHAT_CA_BUNDLE_FILE=
# Comma-separated internal user IDs, not email addresses.
ADMIN_USER_IDS=
# Disabled until an explicitly approved release/budget. No automatic top-up.
AI_CREDIT_MODE=disabled
# NEW charges keep the approved operator ceiling unless explicitly opted in.
# user_balance requires fixed5_overdraft + routerai_citygo_10x, migration 0045,
# a newly approved RouterAI execution key and a compatible release profile.
# It is a balance snapshot / accounting limit, not a provider hard billing cap.
AI_REQUEST_COST_LIMIT_MODE=operator_ceiling
# Explicit new billing authority only; never enabled by a migration or old receipt.
# postpay_actual_v1 requires enabled three-mode catalog, CityGo10x, fixed5 transport
# compatibility, operator_ceiling config, migration0046 and runtime profilev14.
# Customer funds are not held; successful terminal answers settle actual cost.
AI_CUSTOMER_BILLING_MODE=legacy
# Test checkout only: a separate disposable DB, non-production, disabled AI,
# AI_CREDIT_MODE=routerai_citygo_10x, and HTTPS WEB_ORIGIN are mandatory.
# Never put a live key here. Store actual credentials in the closed API config.
YOOKASSA_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
