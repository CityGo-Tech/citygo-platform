{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".env"],
  "globalEnv": ["API_INTERNAL_URL"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "ROUTERAI_API_KEY",
    "ROUTERAI_MODEL",
    "ROUTERAI_UPSTREAM",
    "ROUTERAI_COUNTRY",
    "GIGACHAT_CREDENTIALS",
    "GIGACHAT_MODEL",
    "GIGACHAT_SCOPE",
    "GIGACHAT_CA_BUNDLE_FILE",
    "LLM_PROVIDER",
    "LLM_REQUEST_TIMEOUT_MS",
    "LLM_MAX_OUTPUT_TOKENS",
    "LLM_MAX_INPUT_BYTES",
    "LLM_USER_DAILY_REQUEST_LIMIT",
    "LLM_GLOBAL_DAILY_REQUEST_LIMIT",
    "LLM_USER_DAILY_ATTEMPT_LIMIT",
    "LLM_GLOBAL_DAILY_ATTEMPT_LIMIT",
    "WEB_ORIGIN",
    "API_PORT",
    "API_HOST",
    "ADMIN_USER_IDS",
    "TRUSTED_PROXY_CIDRS",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
