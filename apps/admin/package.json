{
  "name": "@citygo/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsup src/index.tsx --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@citygo/api-client": "workspace:*",
    "@citygo/contracts": "workspace:*",
    "@citygo/ui-web": "workspace:*",
    "react": "19.3.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "@types/react": "^19.3.0"
  }
}
