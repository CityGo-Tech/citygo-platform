{
  "name": "@citygo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs mobile pnpm exec expo start",
    "export": "node ../../scripts/with-env.mjs mobile pnpm exec expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts src",
    "test": "node --import tsx --test src/*.test.mts"
  },
  "dependencies": {
    "@citygo/api-client": "workspace:*",
    "@citygo/contracts": "workspace:*",
    "@citygo/ui-native": "workspace:*",
    "@citygo/design-tokens": "workspace:*",
    "@citygo/content": "workspace:*",
    "expo": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "react-native": "0.87.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo-crypto": "~57.0.3",
    "react-native-safe-area-context": "~5.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.2"
  }
}
