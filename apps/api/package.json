{
  "name": "@citygo/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup ./src/server.ts ./src/preview-policy.ts ./src/preview-payments.ts ./src/account-maintenance.ts --format esm --sourcemap --clean",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "node ../../scripts/with-env.mjs api pnpm exec tsx watch src/dev.ts",
    "lint": "eslint src",
    "start": "node ../../scripts/with-env.mjs api node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=3 src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@citygo/contracts": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.5.0",
    "zod": "^4.1.1",
    "@citygo/db": "workspace:*",
    "@citygo/config": "workspace:*",
    "@citygo/agents": "workspace:*",
    "@citygo/llm": "workspace:*",
    "@citygo/observability": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "@citygo/testkit": "workspace:*"
  }
}
