{
  "name": "@citygo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/sync-assets.mjs && next build",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "node ../../scripts/sync-assets.mjs && next dev",
    "lint": "eslint src",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@citygo/contracts": "workspace:*",
    "next": "^16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@citygo/ui-web": "workspace:*",
    "@citygo/api-client": "workspace:*",
    "@citygo/content": "workspace:*",
    "@citygo/assets": "workspace:*",
    "@citygo/design-tokens": "workspace:*",
    "@citygo/admin": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
